{
  "name": "jizy-modalizer",
  "version": "3.0.7",
  "browser": "dist/js/jizy-modalizer.min.js",
  "main": "lib/index.js",
  "type": "module",
  "jizy": "dist/",
  "author": "Joffrey Demetz <joffrey.demetz@gmail.com> (https://joffreydemetz.com/)",
  "license": "MIT",
  "description": "Modal layer manager for web applications. It provides a simple API to manage modal dialogs, including opening, closing, and customizing modals.",
  "homepage": "https://jizy.joffreydemetz.com/modalizer",
  "keywords": [
    "modal",
    "dialog",
    "layer",
    "ui",
    "frontend",
    "user interface"
  ],
  "files": [
    "dist/*",
    "lib/*"
  ],
  "scripts": {
    "jpack:export": "node ./cli/jpack.js --action build --name perso",
    "jpack:dist": "node ./cli/jpack.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "transform": {}
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joffreydemetz/jizy-modalizer.git"
  },
  "dependencies": {
    "jizy-packer": "^2.1.44"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "less": "^4.6.4"
  }
}
