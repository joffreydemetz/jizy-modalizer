{
  "name": "jizy-modalizer",
  "version": "2.0.5",
  "browser": "dist/js/jizy-modalizer.min.js",
  "jizy": {
    "css": [
      "dist/css/jizy-modalizer.min.css"
    ]
  },
  "main": "lib/index.js",
  "type": "module",
  "files": [
    "dist/js/jizy-modalizer.min.js",
    "dist/css/jizy-modalizer.min.css",
    "lib/js/*.js",
    "lib/less/*.less",
    "lib/index.js",
    "lib/modalizer.less"
  ],
  "scripts": {
    "jpack:export": "node ./cli/jpack.js -t perso",
    "jpack:export-debug": "node ./cli/jpack.js -t perso --debug",
    "jpack:dist": "node ./cli/jpack.js -t dist -n default",
    "jpack:dist-debug": "node ./cli/jpack.js -t dist -n default --debug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joffreydemetz/jizy-modalizer.git"
  },
  "keywords": [
    "modal",
    "dialog",
    "layer",
    "ui",
    "frontend",
    "user interface"
  ],
  "author": "Joffrey Demetz <joffrey.demetz@gmail.com> (https://joffreydemetz.com/)",
  "license": "MIT",
  "description": "Modal layer manager for web applications. It provides a simple API to manage modal dialogs, including opening, closing, and customizing modals.",
  "dependencies": {
    "jizy-packer": "^2.0.0"
  }
}