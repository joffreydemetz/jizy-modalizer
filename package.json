{
  "name": "jizy-modalizer",
  "version": "2.1.0",
  "browser": "dist/js/jizy-modalizer.min.js",
  "main": "lib/index.js",
  "type": "module",
  "jizy": "dist/",
  "files": [
    "dist/*",
    "lib/*"
  ],
  "scripts": {
    "jpack:export": "node ./cli/jpack.js --action build --name perso",
    "jpack:export-debug": "node ./cli/jpack.js --action build --name perso --debug",
    "jpack:dist": "node ./cli/jpack.js",
    "jpack:dist-debug": "node ./cli/jpack.js --debug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joffreydemetz/jizy-modalizer.git"
  },
  "keywords": [
    "modal",
    "dialog",
    "layer",
    "ui",
    "frontend",
    "user interface"
  ],
  "author": "Joffrey Demetz <joffrey.demetz@gmail.com> (https://joffreydemetz.com/)",
  "license": "MIT",
  "description": "Modal layer manager for web applications. It provides a simple API to manage modal dialogs, including opening, closing, and customizing modals.",
  "dependencies": {
    "jizy-packer": "^2.1.0"
  }
}